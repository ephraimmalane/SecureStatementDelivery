{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SecureStatementDelivery"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "secure-statements",
    "ClientId": "secure-statement-delivery",
    "ClientSecret": "",
    "AdminUsername": "",
    "AdminPassword": ""
  },
  "DownloadToken": {
    "Secret": "",
    "PreviousSecrets": [],
    "Issuer": "statement-download"
  },
  "FieldEncryption": {
    "Key": ""
  },
  "ClamAv": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 3310,
    "MaxStreamSizeBytes": 67108864
  },
  "Consolidation": {
    "MaxMonths": 12,
    "CacheTtlMinutes": 60,
    "MaxCacheableBytes": 20971520
  },
  "Storage": {
    "Provider": "Local",
    "LocalBasePath": "storage",
    "MaxUploadBytes": 52428800,
    "ResumableUploadTempPath": "storage/uploads-temp",
    "S3": {
      "BucketName": "",
      "Region": "",
      "ServiceUrl": "",
      "ForcePathStyle": false,
      "PresignedUrlExpiryMinutes": 5,
      "KmsKeyId": "",
      "UseObjectLock": false,
      "ObjectLockMode": "Governance",
      "RetentionDays": 2555
    }
  }
}
