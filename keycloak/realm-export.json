{
  "realm": "secure-statements",
  "enabled": true,
  "displayName": "Secure Statement Delivery",
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(3)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "System administrator — full upload, read, revoke, and audit access"
      },
      {
        "name": "customer",
        "description": "Customer — read own statements and download via signed links"
      },
      {
        "name": "statement-ingest",
        "description": "Machine ingestion — the statement-generation pipeline pushes statements (no human/customer access)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "secure-statement-delivery",
      "name": "Secure Statement Delivery API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "secure-statement-delivery",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "statement-generator",
      "name": "Statement Generation Pipeline (M2M ingestion)",
      "description": "Confidential service-account client. The bank's statement generator obtains a token via the client_credentials grant and pushes statements to POST /statements/ingest.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_INGEST_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "secure-statement-delivery",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "0a0a0a0a-0000-4000-a000-0000000000ad",
      "username": "admin@securestatements.local",
      "email": "admin@securestatements.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "Adm1n!Local2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-statement-generator",
      "enabled": true,
      "serviceAccountClientId": "statement-generator",
      "realmRoles": [
        "statement-ingest"
      ]
    }
  ]
}
