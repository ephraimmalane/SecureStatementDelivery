{
  "uid": "web-api-overview",
  "title": "Secure Statement Delivery — Web API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate (by status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"web-api\"}[5m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error ratio (SLO 0.5%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "job:web_api_request_error_ratio:5m", "legendFormat": "5xx ratio" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "job:web_api_request_latency_p95:5m", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Statement ingestion (uploaded vs rejected)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(statements_uploaded_total{job=\"web-api\"}[5m]))", "legendFormat": "uploaded" },
        { "refId": "B", "expr": "sum(rate(statements_upload_rejected_total{job=\"web-api\"}[5m]))", "legendFormat": "rejected" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox dispatch (processed vs failed)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(outbox_processed_total{job=\"web-api\"}[5m]))", "legendFormat": "processed" },
        { "refId": "B", "expr": "sum(rate(outbox_failed_total{job=\"web-api\"}[5m]))", "legendFormat": "failed" }
      ]
    }
  ]
}
